# Google Earth Engine
# Create/select a Cloud project at https://console.cloud.google.com, register it for
# Earth Engine access at https://code.earthengine.google.com/register, and pick a
# noncommercial quota tier. Then set the project id here.
GEE_PROJECT_ID=your-gcp-project-id
# Path to a service account key file, optional. Leave the value below empty
# for local dev (uses `ee.Authenticate()` / browser login instead). Only set
# this for server deployment -- and do not add a trailing comment on the same
# line as the value, dotenv treats it as part of the value literally.
GEE_SERVICE_ACCOUNT_JSON=

# App
APP_ENV=development
DATABASE_URL=sqlite:///./crop_classification.db
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000

# Pilot region defaults (Rupandehi District, Lumbini Province, Nepal -- Terai
# farmland near Siddharthanagar/Bhairahawa)
DEFAULT_AOI_LAT=27.4833
DEFAULT_AOI_LON=83.4500
